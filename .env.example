# civic-link configuration
#
# Copy to .env and edit. All variables use the CIVIC_LINK_ prefix.
# Nested settings use a double-underscore delimiter (e.g. CIVIC_LINK_CIVIC__BASE_URL).

# --- Server ---
CIVIC_LINK_HOST=127.0.0.1
CIVIC_LINK_ALLOW_PUBLIC_BIND=false
CIVIC_LINK_PORT=8000
# transport: unified | http | stdio
CIVIC_LINK_TRANSPORT=unified
CIVIC_LINK_MCP_PATH=/mcp
CIVIC_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
CIVIC_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
CIVIC_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CIVIC_LINK_LOG_LEVEL=INFO
# log_format: json | console
CIVIC_LINK_LOG_FORMAT=console

# --- CIViC upstream (nested: civic) ---
CIVIC_LINK_CIVIC__BASE_URL=https://civicdb.org
CIVIC_LINK_CIVIC__REQUEST_TIMEOUT_S=20.0
# Politeness: CIViC publishes no hard limit; 0.3 s spacing (~200/min) keeps it polite.
CIVIC_LINK_CIVIC__MIN_INTERVAL_S=0.3
CIVIC_LINK_CIVIC__DAILY_CAP=20000
CIVIC_LINK_CIVIC__MAX_WAIT_S=20.0
CIVIC_LINK_CIVIC__MAX_RETRIES=2
CIVIC_LINK_CIVIC__BACKOFF_BASE_S=2.0
CIVIC_LINK_CIVIC__MAX_RESPONSE_BYTES=16777216
# In-process response cache (no on-disk state)
CIVIC_LINK_CIVIC__CACHE_TTL_S=900
CIVIC_LINK_CIVIC__CACHE_MAXSIZE=512
